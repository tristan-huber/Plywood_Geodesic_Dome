          "interpreterVersion": 1,
          "code": "/**\n * Flat 2D outline of one dome rib, drawn in the rib's own plane.\n * ribIndex picks which rib length this is (0 = A, the shortest) among the\n * distinct edge lengths of the chosen frequency's dome. Indexes past the last\n * length reuse the longest; Dome Frame only places the ones the frequency uses.\n *\n * The rib stands in the plane through the dome center and its edge, so it is\n * a flat part. Origin = dome center, +Y = toward the middle of the edge.\n * Near each end the outer and inner edges follow the hub cap planes (which are\n * perpendicular to the hub's radial axis) out to the cap radius, so the caps\n * sit flat on the rib. The ends stop at the hub core, parallel to the axis.\n */\nfunction run(\n  domeDiameter: number = 4000,\n  frequency: number = 3,\n  ribIndex: number = 0,\n  ribDepth: number = 120,\n  hubDiameter: number = 300,\n  hubCoreDiameter: number = 80,\n): Assembly {\n  const R = domeDiameter / 2;\n  const f = Math.max(1, Math.min(4, Math.round(frequency)));\n\n  // Distinct chord factors (edge length / radius) of the dome above the equator.\n  // Must match the geodesic in Dome Frame: icosahedron with a vertex on top.\n  type V = [number, number, number];\n  const norm = (v: V): V => {\n    const l = Math.hypot(v[0], v[1], v[2]);\n    return [v[0] / l, v[1] / l, v[2] / l];\n  };\n  const ico: V[] = [[0, 0, 1]];\n  const zr = 1 / Math.sqrt(5), rr = 2 / Math.sqrt(5);\n  for (let k = 0; k < 5; k++) {\n    const a = (k * 72 * Math.PI) / 180;\n    ico.push([rr * Math.cos(a), rr * Math.sin(a), zr]);\n  }\n  for (let k = 0; k < 5; k++) {\n    const a = ((36 + k * 72) * Math.PI) / 180;\n    ico.push([rr * Math.cos(a), rr * Math.sin(a), -zr]);\n  }\n  ico.push([0, 0, -1]);\n  const U = (k: number) => 1 + (k % 5);\n  const L = (k: number) => 6 + (k % 5);\n  const faces: [number, number, number][] = [];\n  for (let k = 0; k < 5; k++) {\n    faces.push([0, U(k), U(k + 1)], [U(k), L(k), U(k + 1)], [U(k + 1), L(k), L(k + 1)], [11, L(k + 1), L(k)]);\n  }\n  const factors: number[] = [];\n  for (const [ia, ib, ic] of faces) {\n    const A = ico[ia], B = ico[ib], C = ico[ic];\n    const P = (i: number, j: number): V => {\n      const k = f - i - j;\n      return norm([\n        (k * A[0] + i * B[0] + j * C[0]) / f,\n        (k * A[1] + i * B[1] + j * C[1]) / f,\n        (k * A[2] + i * B[2] + j * C[2]) / f,\n      ]);\n    };\n    for (let i = 0; i < f; i++) {\n      for (let j = 0; j < f - i; j++) {\n        const pts = [P(i, j), P(i + 1, j), P(i, j + 1)];\n        for (let e = 0; e < 3; e++) {\n          const a = pts[e], b = pts[(e + 1) % 3];\n          if (a[2] < -1e-6 || b[2] < -1e-6) continue;\n          const d = Math.hypot(a[0] - b[0], a[1] - b[1], a[2] - b[2]);\n          if (!factors.some((x) => Math.abs(x - d) < 1e-4)) factors.push(d);\n        }\n      }\n    }\n  }\n  factors.sort((x, y) => x - y);\n  const chordFactor = factors[Math.max(0, Math.min(factors.length - 1, Math.round(ribIndex)))];\n\n  const half = Math.asin(chordFactor / 2); // half the central angle of the edge\n  const s = Math.sin(half), c = Math.cos(half);\n  const rCore = hubCoreDiameter / 2, rCap = hubDiameter / 2;\n  if (rCap <= rCore) throw new Error(\"Hub Diameter must be larger than Hub Core Diameter\");\n  if (2 * rCap * c >= chordFactor * R) throw new Error(\"Hubs are too big for this dome: caps would meet\");\n\n  // Hub axes (unit) at each end, and cap-plane directions pointing along the rib\n  const uP = [-s, c], uQ = [s, c];\n  const tP = [c, s], tQ = [-c, s];\n  const at = (u: number[], t: number[], radius: number, d: number): [number, number] => [\n    u[0] * radius + t[0] * d,\n    u[1] * radius + t[1] * d,\n  ];\n  const rIn = R - ribDepth;\n\n  const pts: [number, number][] = [\n    at(uP, tP, R, rCore),\n    at(uP, tP, R, rCap),\n    at(uQ, tQ, R, rCap),\n    at(uQ, tQ, R, rCore),\n    at(uQ, tQ, rIn, rCore),\n    at(uQ, tQ, rIn, rCap),\n    at(uP, tP, rIn, rCap),\n    at(uP, tP, rIn, rCore),\n  ];\n  let d = replicad.draw(pts[0]);\n  for (let i = 1; i < pts.length; i++) d = d.lineTo(pts[i]);\n  return new Assembly({ geometry: d.close() });\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * Flat 2D outline of one dome rib, drawn in the rib's own plane.\n * ribIndex picks which rib length this is (0 = A, the shortest) among the\n * distinct edge lengths of the chosen frequency's dome. Indexes past the last\n * length reuse the longest; Dome Frame only places the ones the frequency uses.\n *\n * The rib stands in the plane through the dome center and its edge, so it is\n * a flat part. Origin = dome center, +Y = toward the middle of the edge.\n * Near each end the outer and inner edges follow the hub cap planes (which are\n * perpendicular to the hub's radial axis) out to the cap radius, so the caps\n * sit flat on the rib. The ends stop at the hub core, parallel to the axis.\n */\nfunction run(domeDiameter = 4000, frequency = 3, ribIndex = 0, ribDepth = 120, hubDiameter = 300, hubCoreDiameter = 80) {\n    const R = domeDiameter / 2;\n    const f = Math.max(1, Math.min(4, Math.round(frequency)));\n    const norm = (v) => {\n        const l = Math.hypot(v[0], v[1], v[2]);\n        return [v[0] / l, v[1] / l, v[2] / l];\n    };\n    const ico = [[0, 0, 1]];\n    const zr = 1 / Math.sqrt(5), rr = 2 / Math.sqrt(5);\n    for (let k = 0; k < 5; k++) {\n        const a = (k * 72 * Math.PI) / 180;\n        ico.push([rr * Math.cos(a), rr * Math.sin(a), zr]);\n    }\n    for (let k = 0; k < 5; k++) {\n        const a = ((36 + k * 72) * Math.PI) / 180;\n        ico.push([rr * Math.cos(a), rr * Math.sin(a), -zr]);\n    }\n    ico.push([0, 0, -1]);\n    const U = (k) => 1 + (k % 5);\n    const L = (k) => 6 + (k % 5);\n    const faces = [];\n    for (let k = 0; k < 5; k++) {\n        faces.push([0, U(k), U(k + 1)], [U(k), L(k), U(k + 1)], [U(k + 1), L(k), L(k + 1)], [11, L(k + 1), L(k)]);\n    }\n    const factors = [];\n    for (const [ia, ib, ic] of faces) {\n        const A = ico[ia], B = ico[ib], C = ico[ic];\n        const P = (i, j) => {\n            const k = f - i - j;\n            return norm([\n                (k * A[0] + i * B[0] + j * C[0]) / f,\n                (k * A[1] + i * B[1] + j * C[1]) / f,\n                (k * A[2] + i * B[2] + j * C[2]) / f,\n            ]);\n        };\n        for (let i = 0; i < f; i++) {\n            for (let j = 0; j < f - i; j++) {\n                const pts = [P(i, j), P(i + 1, j), P(i, j + 1)];\n                for (let e = 0; e < 3; e++) {\n                    const a = pts[e], b = pts[(e + 1) % 3];\n                    if (a[2] < -1e-6 || b[2] < -1e-6)\n                        continue;\n                    const d = Math.hypot(a[0] - b[0], a[1] - b[1], a[2] - b[2]);\n                    if (!factors.some((x) => Math.abs(x - d) < 1e-4))\n                        factors.push(d);\n                }\n            }\n        }\n    }\n    factors.sort((x, y) => x - y);\n    const chordFactor = factors[Math.max(0, Math.min(factors.length - 1, Math.round(ribIndex)))];\n    const half = Math.asin(chordFactor / 2); // half the central angle of the edge\n    const s = Math.sin(half), c = Math.cos(half);\n    const rCore = hubCoreDiameter / 2, rCap = hubDiameter / 2;\n    if (rCap <= rCore)\n        throw new Error(\"Hub Diameter must be larger than Hub Core Diameter\");\n    if (2 * rCap * c >= chordFactor * R)\n        throw new Error(\"Hubs are too big for this dome: caps would meet\");\n    // Hub axes (unit) at each end, and cap-plane directions pointing along the rib\n    const uP = [-s, c], uQ = [s, c];\n    const tP = [c, s], tQ = [-c, s];\n    const at = (u, t, radius, d) => [\n        u[0] * radius + t[0] * d,\n        u[1] * radius + t[1] * d,\n    ];\n    const rIn = R - ribDepth;\n    const pts = [\n        at(uP, tP, R, rCore),\n        at(uP, tP, R, rCap),\n        at(uQ, tQ, R, rCap),\n        at(uQ, tQ, R, rCore),\n        at(uQ, tQ, rIn, rCore),\n        at(uQ, tQ, rIn, rCap),\n        at(uP, tP, rIn, rCap),\n        at(uP, tP, rIn, rCore),\n    ];\n    let d = replicad.draw(pts[0]);\n    for (let i = 1; i < pts.length; i++)\n        d = d.lineTo(pts[i]);\n    return new Assembly({ geometry: d.close() });\n}\n"
