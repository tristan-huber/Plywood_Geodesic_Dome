          "interpreterVersion": 1,
          "code": "/**\n * Places the plywood dome parts. Builds no geometry itself: it copies the\n * Rib A-F and Hub Cap parts (made once each in their own molecules) into\n * position, so the cost is only cheap transforms.\n *\n * Geodesic dome of the chosen frequency (1V-4V), icosahedron with a vertex on\n * top, cut at the equator. Rib A is the shortest edge length, B the next, etc.\n * (1V uses A; 2V A-B; 3V A-C; 4V A-F.) Ribs stand in the plane through the\n * dome center and their edge. Each hub gets an outer cap (on the rib tops) and\n * an inner cap (under the rib bottoms). Parts only touch, never overlap, so\n * the slow overlap-cutting pass is skipped.\n */\nfunction run(\n  ribA: Assembly | undefined = undefined,\n  ribB: Assembly | undefined = undefined,\n  ribC: Assembly | undefined = undefined,\n  ribD: Assembly | undefined = undefined,\n  ribE: Assembly | undefined = undefined,\n  ribF: Assembly | undefined = undefined,\n  hubCap: Assembly | undefined = undefined,\n  frequency: number = 3,\n  domeDiameter: number = 4000,\n  plywoodThickness: number = 18,\n  ribDepth: number = 120,\n): Assembly {\n  const R = domeDiameter / 2;\n  const T = plywoodThickness;\n  const f = Math.max(1, Math.min(4, Math.round(frequency)));\n  type V = [number, number, number];\n  const norm = (v: V): V => {\n    const l = Math.hypot(v[0], v[1], v[2]);\n    return [v[0] / l, v[1] / l, v[2] / l];\n  };\n  const cross = (a: V, b: V): V => [\n    a[1] * b[2] - a[2] * b[1],\n    a[2] * b[0] - a[0] * b[2],\n    a[0] * b[1] - a[1] * b[0],\n  ];\n\n  // Icosahedron with a vertex at the top\n  const ico: V[] = [[0, 0, 1]];\n  const zr = 1 / Math.sqrt(5), rr = 2 / Math.sqrt(5);\n  for (let k = 0; k < 5; k++) {\n    const a = (k * 72 * Math.PI) / 180;\n    ico.push([rr * Math.cos(a), rr * Math.sin(a), zr]);\n  }\n  for (let k = 0; k < 5; k++) {\n    const a = ((36 + k * 72) * Math.PI) / 180;\n    ico.push([rr * Math.cos(a), rr * Math.sin(a), -zr]);\n  }\n  ico.push([0, 0, -1]);\n  const U = (k: number) => 1 + (k % 5);\n  const L = (k: number) => 6 + (k % 5);\n  const faces: [number, number, number][] = [];\n  for (let k = 0; k < 5; k++) {\n    faces.push([0, U(k), U(k + 1)], [U(k), L(k), U(k + 1)], [U(k + 1), L(k), L(k + 1)], [11, L(k + 1), L(k)]);\n  }\n\n  // Subdivide each face and project onto the unit sphere\n  const verts: V[] = [];\n  const vIndex = new Map<string, number>();\n  const addVert = (p: V): number => {\n    const n = norm(p);\n    const key = n.map((c) => Math.round(c * 1e6)).join(\",\");\n    let i = vIndex.get(key);\n    if (i === undefined) {\n      i = verts.length;\n      verts.push(n);\n      vIndex.set(key, i);\n    }\n    return i;\n  };\n  const edges = new Map<string, [number, number]>();\n  const addEdge = (a: number, b: number) => {\n    const key = a < b ? `${a}-${b}` : `${b}-${a}`;\n    if (!edges.has(key)) edges.set(key, [a, b]);\n  };\n  for (const [ia, ib, ic] of faces) {\n    const A = ico[ia], B = ico[ib], C = ico[ic];\n    const P = (i: number, j: number) => {\n      const k = f - i - j;\n      return addVert([\n        (k * A[0] + i * B[0] + j * C[0]) / f,\n        (k * A[1] + i * B[1] + j * C[1]) / f,\n        (k * A[2] + i * B[2] + j * C[2]) / f,\n      ]);\n    };\n    for (let i = 0; i < f; i++) {\n      for (let j = 0; j < f - i; j++) {\n        const p0 = P(i, j), p1 = P(i + 1, j), p2 = P(i, j + 1);\n        addEdge(p0, p1); addEdge(p1, p2); addEdge(p2, p0);\n      }\n    }\n  }\n\n  // Keep the upper part of the sphere\n  const keep = verts.map((v) => v[2] >= -1e-6);\n  const usedVerts = verts.map((_, i) => i).filter((i) => keep[i]);\n  const usedEdges = [...edges.values()].filter(([a, b]) => keep[a] && keep[b]);\n  const lift = -Math.min(...usedVerts.map((i) => verts[i][2])) * R;\n\n  // Rib classes: distinct unit edge lengths, shortest first (same rule as the Rib molecules)\n  const unitLen = ([a, b]: [number, number]) =>\n    Math.hypot(verts[a][0] - verts[b][0], verts[a][1] - verts[b][1], verts[a][2] - verts[b][2]);\n  const factors: number[] = [];\n  for (const e of usedEdges) {\n    const d = unitLen(e);\n    if (!factors.some((x) => Math.abs(x - d) < 1e-4)) factors.push(d);\n  }\n  factors.sort((x, y) => x - y);\n  const ribs = [ribA, ribB, ribC, ribD, ribE, ribF];\n  const names = [\"Rib A\", \"Rib B\", \"Rib C\", \"Rib D\", \"Rib E\", \"Rib F\"];\n  if (factors.length > ribs.length) throw new Error(`${f}V needs ${factors.length} rib types; only ${ribs.length} are available`);\n  const counts = factors.map(() => 0);\n\n  // Rotation taking local axes X, Y, Z onto the given world axes (axis-angle via quaternion)\n  const place = (shape: any, X: V, Y: V, Z: V, t: V) => {\n    const m00 = X[0], m01 = Y[0], m02 = Z[0];\n    const m10 = X[1], m11 = Y[1], m12 = Z[1];\n    const m20 = X[2], m21 = Y[2], m22 = Z[2];\n    let w, x, y, z;\n    const tr = m00 + m11 + m22;\n    if (tr > 0) {\n      const S = Math.sqrt(tr + 1) * 2;\n      w = S / 4; x = (m21 - m12) / S; y = (m02 - m20) / S; z = (m10 - m01) / S;\n    } else if (m00 > m11 && m00 > m22) {\n      const S = Math.sqrt(1 + m00 - m11 - m22) * 2;\n      w = (m21 - m12) / S; x = S / 4; y = (m01 + m10) / S; z = (m02 + m20) / S;\n    } else if (m11 > m22) {\n      const S = Math.sqrt(1 + m11 - m00 - m22) * 2;\n      w = (m02 - m20) / S; x = (m01 + m10) / S; y = S / 4; z = (m12 + m21) / S;\n    } else {\n      const S = Math.sqrt(1 + m22 - m00 - m11) * 2;\n      w = (m10 - m01) / S; x = (m02 + m20) / S; y = (m12 + m21) / S; z = S / 4;\n    }\n    const sinHalf = Math.hypot(x, y, z);\n    let s = shape;\n    if (sinHalf > 1e-9) {\n      const angle = (2 * Math.atan2(sinHalf, w) * 180) / Math.PI;\n      s = s.rotate(angle, [0, 0, 0], [x / sinHalf, y / sinHalf, z / sinHalf]);\n    }\n    return s.translate(t[0], t[1], t[2] + lift);\n  };\n\n  // Copy an Assembly with every leaf's geometry transformed\n  const transformAsm = (asm: Assembly, fn: (g: any) => any): Assembly => {\n    if (asm.isLeaf()) return new Assembly({ ...asm, geometry: fn(asm.geometry.clone()) });\n    return new Assembly({\n      ...asm,\n      geometry: (asm.geometry as any[]).map((c: Assembly) => transformAsm(c, fn)),\n    });\n  };\n\n  const parts: Assembly[] = [];\n  for (const e of usedEdges) {\n    const [a, b] = e;\n    const d = unitLen(e);\n    const cls = factors.findIndex((x) => Math.abs(x - d) < 1e-4);\n    counts[cls]++;\n    const rib = ribs[cls];\n    if (!rib) continue;\n    const p: V = [verts[a][0] * R, verts[a][1] * R, verts[a][2] * R];\n    const q: V = [verts[b][0] * R, verts[b][1] * R, verts[b][2] * R];\n    const X = norm([q[0] - p[0], q[1] - p[1], q[2] - p[2]]);\n    const Y = norm([p[0] + q[0], p[1] + q[1], p[2] + q[2]]);\n    const Z = cross(X, Y);\n    parts.push(transformAsm(rib, (g) => place(g.translate(0, 0, -T / 2), X, Y, Z, [0, 0, 0])));\n  }\n\n  if (hubCap) {\n    for (const i of usedVerts) {\n      const u = verts[i];\n      // Any two axes perpendicular to the hub axis (the cap is round)\n      const ref: V = Math.abs(u[2]) < 0.9 ? [0, 0, 1] : [1, 0, 0];\n      const X = norm(cross(ref, u));\n      const Y = cross(u, X);\n      for (const r of [R, R - ribDepth - T]) {\n        parts.push(transformAsm(hubCap, (g) => place(g, X, Y, u, [u[0] * r, u[1] * r, u[2] * r])));\n      }\n    }\n  }\n\n  const bom = factors.map((x, i) => `${counts[i]}x ${names[i]} (${(x * R).toFixed(1)} mm hub-center to hub-center)`);\n  bom.push(`${usedVerts.length * 2}x Hub Cap`);\n  console.log(`${f}V dome, diameter ${domeDiameter} mm: ${usedVerts.length} hubs, ${usedEdges.length} ribs`);\n  bom.forEach((s) => console.log(s));\n\n  return new Assembly({ geometry: parts, bom }).skipDisjointPostprocess();\n}\n",
          "compiledCode": "\"use strict\";\n/**\n * Places the plywood dome parts. Builds no geometry itself: it copies the\n * Rib A-F and Hub Cap parts (made once each in their own molecules) into\n * position, so the cost is only cheap transforms.\n *\n * Geodesic dome of the chosen frequency (1V-4V), icosahedron with a vertex on\n * top, cut at the equator. Rib A is the shortest edge length, B the next, etc.\n * (1V uses A; 2V A-B; 3V A-C; 4V A-F.) Ribs stand in the plane through the\n * dome center and their edge. Each hub gets an outer cap (on the rib tops) and\n * an inner cap (under the rib bottoms). Parts only touch, never overlap, so\n * the slow overlap-cutting pass is skipped.\n */\nfunction run(ribA = undefined, ribB = undefined, ribC = undefined, ribD = undefined, ribE = undefined, ribF = undefined, hubCap = undefined, frequency = 3, domeDiameter = 4000, plywoodThickness = 18, ribDepth = 120) {\n    const R = domeDiameter / 2;\n    const T = plywoodThickness;\n    const f = Math.max(1, Math.min(4, Math.round(frequency)));\n    const norm = (v) => {\n        const l = Math.hypot(v[0], v[1], v[2]);\n        return [v[0] / l, v[1] / l, v[2] / l];\n    };\n    const cross = (a, b) => [\n        a[1] * b[2] - a[2] * b[1],\n        a[2] * b[0] - a[0] * b[2],\n        a[0] * b[1] - a[1] * b[0],\n    ];\n    // Icosahedron with a vertex at the top\n    const ico = [[0, 0, 1]];\n    const zr = 1 / Math.sqrt(5), rr = 2 / Math.sqrt(5);\n    for (let k = 0; k < 5; k++) {\n        const a = (k * 72 * Math.PI) / 180;\n        ico.push([rr * Math.cos(a), rr * Math.sin(a), zr]);\n    }\n    for (let k = 0; k < 5; k++) {\n        const a = ((36 + k * 72) * Math.PI) / 180;\n        ico.push([rr * Math.cos(a), rr * Math.sin(a), -zr]);\n    }\n    ico.push([0, 0, -1]);\n    const U = (k) => 1 + (k % 5);\n    const L = (k) => 6 + (k % 5);\n    const faces = [];\n    for (let k = 0; k < 5; k++) {\n        faces.push([0, U(k), U(k + 1)], [U(k), L(k), U(k + 1)], [U(k + 1), L(k), L(k + 1)], [11, L(k + 1), L(k)]);\n    }\n    // Subdivide each face and project onto the unit sphere\n    const verts = [];\n    const vIndex = new Map();\n    const addVert = (p) => {\n        const n = norm(p);\n        const key = n.map((c) => Math.round(c * 1e6)).join(\",\");\n        let i = vIndex.get(key);\n        if (i === undefined) {\n            i = verts.length;\n            verts.push(n);\n            vIndex.set(key, i);\n        }\n        return i;\n    };\n    const edges = new Map();\n    const addEdge = (a, b) => {\n        const key = a < b ? `${a}-${b}` : `${b}-${a}`;\n        if (!edges.has(key))\n            edges.set(key, [a, b]);\n    };\n    for (const [ia, ib, ic] of faces) {\n        const A = ico[ia], B = ico[ib], C = ico[ic];\n        const P = (i, j) => {\n            const k = f - i - j;\n            return addVert([\n                (k * A[0] + i * B[0] + j * C[0]) / f,\n                (k * A[1] + i * B[1] + j * C[1]) / f,\n                (k * A[2] + i * B[2] + j * C[2]) / f,\n            ]);\n        };\n        for (let i = 0; i < f; i++) {\n            for (let j = 0; j < f - i; j++) {\n                const p0 = P(i, j), p1 = P(i + 1, j), p2 = P(i, j + 1);\n                addEdge(p0, p1);\n                addEdge(p1, p2);\n                addEdge(p2, p0);\n            }\n        }\n    }\n    // Keep the upper part of the sphere\n    const keep = verts.map((v) => v[2] >= -1e-6);\n    const usedVerts = verts.map((_, i) => i).filter((i) => keep[i]);\n    const usedEdges = [...edges.values()].filter(([a, b]) => keep[a] && keep[b]);\n    const lift = -Math.min(...usedVerts.map((i) => verts[i][2])) * R;\n    // Rib classes: distinct unit edge lengths, shortest first (same rule as the Rib molecules)\n    const unitLen = ([a, b]) => Math.hypot(verts[a][0] - verts[b][0], verts[a][1] - verts[b][1], verts[a][2] - verts[b][2]);\n    const factors = [];\n    for (const e of usedEdges) {\n        const d = unitLen(e);\n        if (!factors.some((x) => Math.abs(x - d) < 1e-4))\n            factors.push(d);\n    }\n    factors.sort((x, y) => x - y);\n    const ribs = [ribA, ribB, ribC, ribD, ribE, ribF];\n    const names = [\"Rib A\", \"Rib B\", \"Rib C\", \"Rib D\", \"Rib E\", \"Rib F\"];\n    if (factors.length > ribs.length)\n        throw new Error(`${f}V needs ${factors.length} rib types; only ${ribs.length} are available`);\n    const counts = factors.map(() => 0);\n    // Rotation taking local axes X, Y, Z onto the given world axes (axis-angle via quaternion)\n    const place = (shape, X, Y, Z, t) => {\n        const m00 = X[0], m01 = Y[0], m02 = Z[0];\n        const m10 = X[1], m11 = Y[1], m12 = Z[1];\n        const m20 = X[2], m21 = Y[2], m22 = Z[2];\n        let w, x, y, z;\n        const tr = m00 + m11 + m22;\n        if (tr > 0) {\n            const S = Math.sqrt(tr + 1) * 2;\n            w = S / 4;\n            x = (m21 - m12) / S;\n            y = (m02 - m20) / S;\n            z = (m10 - m01) / S;\n        }\n        else if (m00 > m11 && m00 > m22) {\n            const S = Math.sqrt(1 + m00 - m11 - m22) * 2;\n            w = (m21 - m12) / S;\n            x = S / 4;\n            y = (m01 + m10) / S;\n            z = (m02 + m20) / S;\n        }\n        else if (m11 > m22) {\n            const S = Math.sqrt(1 + m11 - m00 - m22) * 2;\n            w = (m02 - m20) / S;\n            x = (m01 + m10) / S;\n            y = S / 4;\n            z = (m12 + m21) / S;\n        }\n        else {\n            const S = Math.sqrt(1 + m22 - m00 - m11) * 2;\n            w = (m10 - m01) / S;\n            x = (m02 + m20) / S;\n            y = (m12 + m21) / S;\n            z = S / 4;\n        }\n        const sinHalf = Math.hypot(x, y, z);\n        let s = shape;\n        if (sinHalf > 1e-9) {\n            const angle = (2 * Math.atan2(sinHalf, w) * 180) / Math.PI;\n            s = s.rotate(angle, [0, 0, 0], [x / sinHalf, y / sinHalf, z / sinHalf]);\n        }\n        return s.translate(t[0], t[1], t[2] + lift);\n    };\n    // Copy an Assembly with every leaf's geometry transformed\n    const transformAsm = (asm, fn) => {\n        if (asm.isLeaf())\n            return new Assembly({ ...asm, geometry: fn(asm.geometry.clone()) });\n        return new Assembly({\n            ...asm,\n            geometry: asm.geometry.map((c) => transformAsm(c, fn)),\n        });\n    };\n    const parts = [];\n    for (const e of usedEdges) {\n        const [a, b] = e;\n        const d = unitLen(e);\n        const cls = factors.findIndex((x) => Math.abs(x - d) < 1e-4);\n        counts[cls]++;\n        const rib = ribs[cls];\n        if (!rib)\n            continue;\n        const p = [verts[a][0] * R, verts[a][1] * R, verts[a][2] * R];\n        const q = [verts[b][0] * R, verts[b][1] * R, verts[b][2] * R];\n        const X = norm([q[0] - p[0], q[1] - p[1], q[2] - p[2]]);\n        const Y = norm([p[0] + q[0], p[1] + q[1], p[2] + q[2]]);\n        const Z = cross(X, Y);\n        parts.push(transformAsm(rib, (g) => place(g.translate(0, 0, -T / 2), X, Y, Z, [0, 0, 0])));\n    }\n    if (hubCap) {\n        for (const i of usedVerts) {\n            const u = verts[i];\n            // Any two axes perpendicular to the hub axis (the cap is round)\n            const ref = Math.abs(u[2]) < 0.9 ? [0, 0, 1] : [1, 0, 0];\n            const X = norm(cross(ref, u));\n            const Y = cross(u, X);\n            for (const r of [R, R - ribDepth - T]) {\n                parts.push(transformAsm(hubCap, (g) => place(g, X, Y, u, [u[0] * r, u[1] * r, u[2] * r])));\n            }\n        }\n    }\n    const bom = factors.map((x, i) => `${counts[i]}x ${names[i]} (${(x * R).toFixed(1)} mm hub-center to hub-center)`);\n    bom.push(`${usedVerts.length * 2}x Hub Cap`);\n    console.log(`${f}V dome, diameter ${domeDiameter} mm: ${usedVerts.length} hubs, ${usedEdges.length} ribs`);\n    bom.forEach((s) => console.log(s));\n    return new Assembly({ geometry: parts, bom }).skipDisjointPostprocess();\n}\n"
        },
